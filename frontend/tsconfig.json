{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "baseUrl": "./src",
    "paths": {
      "@takram/three-atmosphere": [
        "../graphics/node_modules/@takram/three-atmosphere/./types/index.d.ts"
      ],
      "@takram/three-atmosphere/shaders/bruneton": [
        "../graphics/node_modules/@takram/three-atmosphere/./types/shaders/bruneton/index.d.ts"
      ],
      "@takram/three-geospatial": [
        "../graphics/node_modules/@takram/three-geospatial/./types/index.d.ts"
      ],
      "3d-tiles-renderer": [
        "../graphics/node_modules/3d-tiles-renderer/./src/index.d.ts"
      ],
      "3d-tiles-renderer/core": [
        "../graphics/node_modules/3d-tiles-renderer/./src/core/renderer/index.d.ts"
      ],
      "3d-tiles-renderer/three": [
        "../graphics/node_modules/3d-tiles-renderer/./src/three/renderer/index.d.ts"
      ],
      "postprocessing": [
        "../graphics/node_modules/postprocessing/build/types/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
