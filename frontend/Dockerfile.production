FROM node:20-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0 AS build
WORKDIR /app
ENV PUPPETEER_SKIP_DOWNLOAD=true
COPY frontend/package*.json ./
RUN npm ci --loglevel=error
COPY frontend/ .
COPY packages/ /packages/
COPY integrations/renderers.lock.json /integrations/renderers.lock.json
COPY runtimes/sky-adapter/ /runtimes/sky-adapter/
RUN npm run build
FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
